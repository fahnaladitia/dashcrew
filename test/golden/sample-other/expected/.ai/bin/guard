#!/bin/sh
# Generated by dashcrew sync. Hooks call this file; it runs dashcrew guard from PATH.
# Without dashcrew 0.5.0 or newer on PATH it refuses every tool call (fail closed).
need=0.5.0

refuse() {
  input=$(cat)
  reason="[dashcrew guard] $1, so this tool call is refused. Install dashcrew $need or newer (brew install fahnaladitia/tap/dashcrew, or go install github.com/fahnaladitia/dashcrew/cmd/dashcrew@latest) and retry."
  case $input in
    *'"hook_event_name"'*) ;;
    *'"toolCall"'*) printf '{"decision":"deny","reason":"%s"}\n' "$reason"; exit 0 ;;
  esac
  echo "$reason" >&2
  exit 2
}

# at_least VERSION: VERSION is major.minor.patch (optional -pre-release, +build) and not older than $need.
at_least() {
  version=${1%%+*}
  core=${version%%-*}
  case $core in
    *[!0-9.]* | .* | *. | *..* | *.*.*.*) return 1 ;;
    *.*.*) ;;
    *) return 1 ;;
  esac
  saved_ifs=$IFS
  IFS=.
  set -- $core $need
  IFS=$saved_ifs
  [ "$1" -ne "$4" ] && { [ "$1" -gt "$4" ]; return; }
  [ "$2" -ne "$5" ] && { [ "$2" -gt "$5" ]; return; }
  [ "$3" -ne "$6" ] && { [ "$3" -gt "$6" ]; return; }
  [ "$version" = "$core" ]
}

path=$(command -v dashcrew 2>/dev/null) || refuse "dashcrew is not on PATH"

# A version check that passed is cached per user as "<path> <need>"; it holds until dashcrew changes or need does.
cache=
if [ -n "${HOME:-}" ]; then
  cache=$HOME/.dashcrew/guard-ok
  if [ -f "$cache" ] && [ ! "$path" -nt "$cache" ] && { read -r line <"$cache"; } 2>/dev/null && [ "$line" = "$path $need" ]; then
    exec "$path" guard "$@"
  fi
fi

have=$("$path" --version 2>/dev/null </dev/null)
at_least "${have##* }" || refuse "the dashcrew on PATH is older than $need or reports no version"
if [ -n "$cache" ]; then
  { [ -d "$HOME/.dashcrew" ] || mkdir -p "$HOME/.dashcrew"; } 2>/dev/null && { printf '%s %s\n' "$path" "$need" >"$cache"; } 2>/dev/null
fi
exec "$path" guard "$@"
