{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "^(Bash|apply_patch|Edit|Write)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"\\$(git rev-parse --show-toplevel)/.ai/bin/guard\" \"\\$(git rev-parse --show-toplevel)/.ai/guard.json\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
