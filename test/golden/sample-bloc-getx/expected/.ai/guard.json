{
  "schema": 1,
  "blocked_git": [
    "cherry-pick",
    "commit",
    "merge",
    "push",
    "rebase",
    "reset",
    "revert",
    "stash",
    "tag"
  ],
  "block_formatters": true,
  "plans_dir": "docs/plans",
  "role_capability": {
    "explorer": "read",
    "reviewer": "read"
  },
  "forbidden_imports": [
    "package:posthog_flutter"
  ],
  "local_packages": [
    "core",
    "analytics_facade"
  ]
}
